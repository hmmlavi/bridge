# Bridge environment configuration
# All variables are OPTIONAL locally, but Postgres is REQUIRED on serverless
# platforms (Vercel) for reliable pairing across instances.

# Postgres connection used for the shared pairing/session store.
# Local dev (matches drizzle.config.json):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# On Vercel this is injected automatically when you attach Vercel Postgres
# (Storage -> Postgres). The app reads it as a fallback for DATABASE_URL.
# POSTGRES_URL=postgresql://...

# If neither is set, the app runs in in-memory mode — fine for a single
# process (local dev / VPS), but pairing will be unreliable on serverless.
